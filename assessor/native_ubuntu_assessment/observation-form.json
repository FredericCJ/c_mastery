{
  "schema_version": 2,
  "status": "template-not-administered",
  "form_notes": {
    "purpose": "One copy per attempt. This template holds no participant data; every field is null, empty, false or a not-assessed marker until a real attempt is recorded. All timestamps are UTC, ISO 8601 with a trailing Z, taken from the clock at the moment of the event and never reconstructed.",
    "attempt_rule": "A failed entry check ends the attempt. Remediation is followed by a new attempt with a new attempt_id; an assisted or remediated attempt is never relabelled independent.",
    "entry_check_results": ["pass", "fail-unstated-prerequisite", "fail-learner-gap", "fail-infrastructure"],
    "imitation_outcomes": ["not-detected", "detected", "inconclusive", "not-applied"],
    "assistance_kinds": ["documentation", "compiler-diagnostic", "prompt", "hint", "solution-exposure", "other"],
    "assistance_tiers": ["none", "nudge", "substantive"],
    "evidence_kinds": ["source", "log", "trace", "oral-answer", "measurement", "other"],
    "independent_learner_result_values": ["not-assessed", "independent", "assisted", "not-independent"],
    "dimension_rule": "A dimension's score is the minimum of the administered criteria mapped to it. Acceptance requires every dimension at least 2 and at least two at 3.",
    "entry_shapes": {
      "accepted_artifacts": {"artifact": "string", "producer_node": "node id", "acceptance_id": "string", "bundle_sha256": "hex", "verified_export": "boolean"},
      "tools": {"name": "string", "version": "string", "path_or_sha256": "string"},
      "probes": {"probe_id": "string", "asked_at": "timestamp", "answer_summary": "string", "outcome": "pass or fail", "maps_to_node": "node id"},
      "remediation": {"for_probe": "string", "action": "string", "completed_at": "timestamp or null"}
    },
    "rejected_alternative_shape": {"alternative": "string", "reason": "string", "smallest_failing_input": "string", "clause_violated": "string"},
    "assistance_shape": {"at": "timestamp", "kind": "from assistance_kinds", "tier": "from assistance_tiers", "by": "string", "description": "string", "counts_against_independence": "boolean"},
    "rubric_score_shape": {"criterion_id": "from the packet", "dimensions": ["dimension keys"], "score": "0 to 3", "evidence": [{"kind": "from evidence_kinds", "ref": "path or timestamp", "sha256": "hex or null", "note": "string"}], "wrong_answer_observed": "boolean", "wrong_answer_note": "string or null", "scored_by": "string", "scored_at": "timestamp"},
    "imitation_check_shape": {"check_id": "from imitation_check_ids_required", "applied_at": "timestamp", "outcome": "from imitation_outcomes", "evidence": "string", "artifacts_compared": ["paths or hashes"], "notes": "string or null"},
    "test_fixture_shape": {"name": "string", "purpose": "string", "label": "TEST IMPLEMENTATION", "produced_by": "string", "produced_at": "timestamp", "sha256": "hex", "path": "string", "note": "Assessor-built fixtures (for example the T-STR-2 writer) are never learner work; record the hash before the sitting."},
    "practice_log_shape": {"at": "timestamp", "mechanism": "route mechanism id", "node": "node id", "supported": "boolean", "source": "string"}
  },

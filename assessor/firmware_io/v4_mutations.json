{
 "startup":[["i<m;i++){bss[i]=0","i+1<m;i++){bss[i]=0"]],
 "vectors":[["&&!(sp&7u)","&&!(sp&3u)"]],
 "gpio":[["pin+(high?0:16)","pin+(high?16:0)"]],
 "uart":[["!valid(io)||await(io,FW_TXE,FW_TXE,polls)","!valid(io)||(!polls)"]],
 "spi":[["io.write(io.context,FW_CONTROL,0);return ok?0:-1;","io.write(io.context,FW_CONTROL,1);return ok?0:-1;"]],
 "i2c":[["i<pulses;i++","i<pulses+1;i++"]],
 "timer":[["FW_PERIOD,ticks-1","FW_PERIOD,ticks"]],
 "adc":[["io.read(io.context,FW_ADC)&4095","io.read(io.context,FW_ADC)&65535"]],
 "dma":[["ticket!=d->generation||!d->state","ticket>d->generation||!d->state"]],
 "ethernet":[["d->own||n<14","n<14"]],
 "rs485":[["await(io,FW_TC,FW_TC,polls)","await(io,FW_TXE,FW_TXE,polls)"]],
 "watchdog":[["w->seen==w->required","w->seen!=0"]]
}

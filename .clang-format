# C Mastery house style: layout layer (Tier L).
# Rationale, provenance and exceptions: curriculum/guides/c-style.md.
# Pinned tool: clang-format 21.1.8 (tools/c_tools_requirements.lock).
# Genuine Linux kernel modules use their own .clang-format (kernel style).
---
# Options shared by every language section below (clang-format applies a
# section without Language to all languages).
BasedOnStyle: LLVM

# BARR-C:2018 layout: 80 columns, 4-space indentation, no tabs.
ColumnLimit: 80
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
# BARR-C 3.6.a: lines end with LF only.
LineEnding: LF
InsertNewlineAtEOF: true

# BARR-C:2018 brace placement (Allman) and mandatory braces
# (BARR-C 1.3, MISRA C:2023 Rule 15.6, CERT EXP19-C).
BreakBeforeBraces: Allman
InsertBraces: true
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
IndentCaseLabels: true
IndentGotoLabels: false

# Declarations and pointers: the asterisk binds to the declarator name,
# which matches how C parses `int *p, q;`.
PointerAlignment: Right
DerivePointerAlignment: false
BreakAfterReturnType: None
BinPackParameters: BinPack
BinPackArguments: true
AllowAllParametersOfDeclarationOnNextLine: false
AlignAfterOpenBracket: Align
AlignOperands: Align
BreakBeforeBinaryOperators: None
Cpp11BracedListStyle: true

# Spacing.
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesBeforeTrailingComments: 2
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: false
SeparateDefinitionBlocks: Always

# Alignment columns churn on every edit; keep them off.
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignConsecutiveBitFields: None
AlignTrailingComments:
  Kind: Never
AlignEscapedNewlines: Left
AlignArrayOfStructures: None

# Token-preserving guarantees used by the equivalence proofs: never reorder
# includes or qualifiers, never split string literals, and only re-indent
# comments. ACSL annotations (/*@ ... */) are never reflowed.
SortIncludes: Never
IncludeBlocks: Preserve
QualifierAlignment: Leave
BreakStringLiterals: false
ReflowComments: IndentOnly
CommentPragmas: '^@'
IndentPPDirectives: None
---
# .c files are parsed as C, so C++ keywords such as `protected` or `new`
# are ordinary identifiers. Headers (.h, .inc) are detected as C++ and use
# the same options; every house-style header formats identically when parsed
# as C, and tools/source_equivalence.py checks inserted brace positions.
Language: C
---
Language: Cpp
...

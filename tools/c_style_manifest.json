{
  "schema_version": 1,
  "description": "Scope and exceptions of the house C style (curriculum/guides/c-style.md). Patterns use fnmatch semantics where * also matches '/'.",
  "clang_format": {
    "version": "21.1.8",
    "binary": "build/author-tools/python/bin/clang-format",
    "house_style": ".clang-format",
    "kernel_style": "tools/clang-format/linux-kernel.clang-format"
  },
  "include": [
    "labs/*.c",
    "labs/*.h",
    "labs/*.inc",
    "assessor/*.c",
    "assessor/*.h",
    "assessor/*.inc"
  ],
  "exclude": [],
  "kernel_style": [
    {
      "path": "assessor/advanced_concurrency_depth/kernel/guest/ak_work.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    },
    {
      "path": "assessor/kernel_lifecycle/guest/b06_irq.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    },
    {
      "path": "assessor/kernel_lifecycle/guest/b06_owner.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    },
    {
      "path": "assessor/peripheral_depth/diagnostic/guest/dg_gadget.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    },
    {
      "path": "labs/peripheral_depth/diagnostic/guest/dg_gadget.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    },
    {
      "path": "labs/advanced_concurrency_depth/kernel/guest/ak_work_stub.c",
      "reason": "Genuine Linux kernel module built with kbuild (GPL-2.0); follows the Linux kernel coding style and checkpatch, as taught in the style guide."
    }
  ],
  "naming_exemptions": [
    {
      "pattern": "*/FreeRTOSConfig.h",
      "reason": "FreeRTOS requires its configXXX macro names."
    },
    {
      "pattern": "*_hal_conf.h",
      "reason": "STM32 HAL requires its HAL_*_MODULE_ENABLED and USE_* macro names."
    },
    {
      "pattern": "labs/realtime_depth/freertos/freestanding_include/*",
      "reason": "Freestanding declarations of the standard library names a hosted header would provide."
    }
  ],

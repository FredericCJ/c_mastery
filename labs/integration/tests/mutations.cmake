set(MUTATION_ARGS "")
foreach(path ${IN_INCLUDES})
 list(APPEND MUTATION_ARGS --include "${path}")
endforeach()
foreach(path ${IN_DEPS})
 list(APPEND MUTATION_ARGS --extra "${path}")
endforeach()
foreach(def ${IN_DEFINES})
 list(APPEND MUTATION_ARGS --define "${def}")
endforeach()
foreach(case ${IN_CASES})
 add_test(NAME integration.negative.${case} COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/v4_mutation.py" --cc "${CMAKE_C_COMPILER}" --source "${IN_SOURCE}/integration.c" --test "${CMAKE_CURRENT_SOURCE_DIR}/tests/contracts.c" --mutations "${IN_SOURCE}/v4_mutations.json" --case ${case} ${MUTATION_ARGS} )
 set_tests_properties(integration.negative.${case} PROPERTIES TIMEOUT 30 LABELS "negative-control;v4")
endforeach()

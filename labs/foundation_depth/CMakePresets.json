{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {"name": "base", "hidden": true, "generator": "Unix Makefiles", "binaryDir": "${sourceDir}/../../build/foundation_depth/${presetName}", "cacheVariables": {"CMAKE_C_STANDARD": "17"}},
    {"name": "gcc-debug", "inherits": "base", "cacheVariables": {"CMAKE_C_COMPILER": "gcc", "CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "gcc-release", "inherits": "base", "cacheVariables": {"CMAKE_C_COMPILER": "gcc", "CMAKE_BUILD_TYPE": "Release"}},
    {"name": "gcc-sanitize", "inherits": "gcc-debug", "cacheVariables": {"CMASTERY_SANITIZE": "ON"}},
    {"name": "clang-debug", "inherits": "base", "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "clang-release", "inherits": "base", "cacheVariables": {"CMAKE_C_COMPILER": "clang", "CMAKE_BUILD_TYPE": "Release"}},
    {"name": "clang-sanitize", "inherits": "clang-debug", "cacheVariables": {"CMASTERY_SANITIZE": "ON"}}
  ]
}

# Reusable hosted correctness policy. Link this interface to implementation
# libraries as well as their final executable; instrumenting only tests is insufficient.
include_guard(GLOBAL)
include(CheckCSourceCompiles)
set(CMASTERY_PROFILE "semantic" CACHE STRING "semantic, instrumented, thread, performance")
set_property(CACHE CMASTERY_PROFILE PROPERTY STRINGS semantic instrumented thread performance)
if(CMASTERY_SANITIZERS)
  if(NOT CMASTERY_PROFILE STREQUAL "semantic" AND NOT CMASTERY_PROFILE STREQUAL "instrumented")
    message(FATAL_ERROR "CMASTERY_SANITIZERS conflicts with the selected profile")
  endif()
  set(CMASTERY_PROFILE "instrumented")
endif()
if(NOT CMASTERY_PROFILE MATCHES "^(semantic|instrumented|thread|performance)$")
  message(FATAL_ERROR "Unknown CMASTERY_PROFILE: ${CMASTERY_PROFILE}")
endif()
get_cmake_property(_cm_variables VARIABLES)
foreach(flags IN LISTS _cm_variables)
  if(flags MATCHES "^CMAKE_((C|ASM)_FLAGS|(EXE|SHARED|MODULE)_LINKER_FLAGS)($|_)" AND "${${flags}}" MATCHES "-fsanitize")
    message(FATAL_ERROR "Select CMASTERY_PROFILE instead of global sanitizer flags: performance targets must stay uninstrumented")
  endif()
endforeach()
add_library(cmastery_correctness INTERFACE)
if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(cmastery_correctness INTERFACE
    $<$<COMPILE_LANGUAGE:C>:-Wall;-Wextra;-Wpedantic>)
  if(CMASTERY_PROFILE STREQUAL "performance")
    target_compile_options(cmastery_correctness INTERFACE $<$<COMPILE_LANGUAGE:C>:-O3;-g>)
  else()
    target_compile_options(cmastery_correctness INTERFACE $<$<COMPILE_LANGUAGE:C>:-O1;-g;-fno-omit-frame-pointer>)
  endif()
endif()
if(CMASTERY_PROFILE STREQUAL "instrumented" OR CMASTERY_PROFILE STREQUAL "thread")
  if(NOT CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    message(FATAL_ERROR "Sanitizer profile requires a supported GCC/Clang toolchain")
  endif()
  if(CMASTERY_PROFILE STREQUAL "thread")
    set(_cm_sanitizer "-fsanitize=thread")
  else()
    set(_cm_sanitizer "-fsanitize=address,undefined")
  endif()
  set(CMAKE_REQUIRED_FLAGS "${_cm_sanitizer}")
  set(CMAKE_REQUIRED_LINK_OPTIONS "${_cm_sanitizer}")
  unset(CMASTERY_SANITIZER_LINKS CACHE)
  check_c_source_compiles("int main(void) { return 0; }" CMASTERY_SANITIZER_LINKS)
  unset(CMAKE_REQUIRED_FLAGS)
  unset(CMAKE_REQUIRED_LINK_OPTIONS)
  if(NOT CMASTERY_SANITIZER_LINKS)
    message(FATAL_ERROR "Requested sanitizer cannot compile/link; inspect the compiler runtime installation")
  endif()
  target_compile_options(cmastery_correctness INTERFACE $<$<COMPILE_LANGUAGE:C>:${_cm_sanitizer}>)
  target_link_options(cmastery_correctness INTERFACE ${_cm_sanitizer})
endif()
function(cmastery_correctness_target name)
  target_link_libraries(${name} PRIVATE cmastery_correctness)
endfunction()
function(cmastery_performance_target name)
  if(CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(${name} PRIVATE $<$<COMPILE_LANGUAGE:C>:-O3;-g;-Wall;-Wextra;-Wpedantic>)
  endif()
endfunction()

{
  "module": "policy_effects",
  "target": "metaprog-policy_effects",
  "learner_option": "CMASTERY_MPP_LEARNER",
  "anchors": [
    "policy_order",
    "policy_failure",
    "policy_saturation",
    "policy_base"
  ],
  "control_count": 8,
  "observation_markers": [
    "MPP_ORDER acquire-project-release left-to-right once",
    "MPP_FAILURE partial-acquisition release output-rollback effects-retained",
    "MPP_SATURATION mandatory-effects late-failure rejection-prefix",
    "MPP_BASE actual-reject-saturate empty-identity"
  ],
  "oracle": "tools/verify_metaprog_policy_effects.py",
  "metrics": [
    "metrics"
  ],
  "object_sources": [
    "policy_effects.c",
    "metaprog.c"
  ],
  "producer": "tools/run_metaprog_policy_effects.py",
  "report": "research/v5/modern/metaprog_policy_effects_validation.json",
  "imports": [
    "labs/metaprog/CONTRACTS.md",
    "labs/metaprog/include/metaprog.h",
    "labs/metaprog/src/metaprog.c",
    "assessor/metaprog/metaprog.c",
    "assessor/metaprog/ring_template.inc",
    "research/v5/modern/metaprog_policy_effects_resources.json",
    "research/v5/modern/metaprog_policy_effects_research_gate.json",
    "tools/register_metaprog_policy_effects.py"
  ]
}

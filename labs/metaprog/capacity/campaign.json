{
  "module": "capacity",
  "target": "metaprog-capacity",
  "learner_option": "CMASTERY_MPC_LEARNER",
  "anchors": [
    "capacity_fixed",
    "capacity_runtime",
    "capacity_refusal",
    "capacity_base"
  ],
  "control_count": 8,
  "observation_markers": [
    "MPC_FIXED capacities1-4-8 masked-wrap FIFO",
    "MPC_RUNTIME volatile-capacity arbitrary-positive fallback",
    "MPC_REFUSAL unchanged-control byte-budget zero-overflow",
    "MPC_BASE actual-checked-product independent-budget"
  ],
  "oracle": "tools/verify_metaprog_capacity.py",
  "metrics": [
    "metrics"
  ],
  "object_sources": [
    "capacity.c",
    "metaprog.c"
  ],
  "producer": "tools/run_metaprog_capacity.py",
  "report": "research/v5/modern/metaprog_capacity_validation.json",
  "imports": [
    "labs/metaprog/CONTRACTS.md",
    "labs/metaprog/include/metaprog.h",
    "labs/metaprog/src/metaprog.c",
    "assessor/metaprog/metaprog.c",
    "assessor/metaprog/ring_template.inc",
    "labs/algorithms/SPEC.md",
    "research/v5/modern/metaprog_capacity_resources.json",
    "research/v5/modern/metaprog_capacity_research_gate.json",
    "tools/register_metaprog_capacity.py"
  ]
}

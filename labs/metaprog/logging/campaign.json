{
  "module": "logging",
  "target": "metaprog-logging",
  "learner_option": "CMASTERY_MPL_LEARNER",
  "anchors": [
    "logging_eval",
    "logging_copy",
    "logging_atomic",
    "logging_base"
  ],
  "control_count": 8,
  "observation_markers": [
    "MPL_EVAL finite-arity once separate-effects protected-comma",
    "MPL_COPY inline-binary filename line no-retained-borrow",
    "MPL_ATOMIC explicit-zero unchanged-refusal evaluated-effects-retained",
    "MPL_BASE actual-numeric-dispatch modulo empty-identity"
  ],
  "oracle": "tools/verify_metaprog_logging.py",
  "metrics": [
    "metrics"
  ],
  "object_sources": [
    "logging.c",
    "metaprog.c"
  ],
  "producer": "tools/run_metaprog_logging.py",
  "report": "research/v5/modern/metaprog_logging_validation.json",
  "imports": [
    "labs/metaprog/CONTRACTS.md",
    "labs/metaprog/include/metaprog.h",
    "labs/metaprog/src/metaprog.c",
    "assessor/metaprog/metaprog.c",
    "assessor/metaprog/ring_template.inc",
    "research/v5/modern/metaprog_logging_resources.json",
    "research/v5/modern/metaprog_logging_research_gate.json",
    "tools/register_metaprog_logging.py"
  ]
}

{
  "module": "build_cache",
  "target": "metaprog-build_cache",
  "learner_option": "CMASTERY_MPB_LEARNER",
  "anchors": [
    "cache_inputs",
    "cache_schedule",
    "cache_publication",
    "cache_base",
    "cache_files",
    "cache_parallel"
  ],
  "control_count": 10,
  "observation_markers": [
    "MPB_INPUTS full-transitive-inputs stable-logical-ids forced-collision-refusal",
    "MPB_SCHEDULE dependency-admission exclusive-tickets drain-before-publication",
    "MPB_PUBLICATION canonical-entry exact-artifact-check bounded-output-transaction",
    "MPB_BASE actual-topology configuration-and-dependency-keys complete-table-width",
    "MPB_FILES process-cuts17 refusal-boundaries17 old-or-new prefix-corruption-refused actual-codec-entry no-power-cut-claim",
    "MPB_PARALLEL actual-two-workers exclusive-outputs dependency-wake failure-drain joined-publication"
  ],
  "oracle": "tools/verify_metaprog_build_cache.py",
  "metrics": [
    "metrics"
  ],
  "object_sources": [
    "build_cache.c",
    "metaprog.c",
    "core.c"
  ],
  "producer": "tools/run_metaprog_build_cache.py",
  "report": "research/v5/modern/metaprog_build_cache_validation.json",
  "imports": [
    "labs/metaprog/CONTRACTS.md",
    "labs/metaprog/include/metaprog.h",
    "labs/metaprog/src/metaprog.c",
    "assessor/metaprog/metaprog.c",
    "assessor/metaprog/ring_template.inc",
    "labs/api_depth/architecture/arch.h",
    "labs/api_depth/architecture/CONTRACTS.md",
    "labs/api_depth/architecture/learner.c",
    "assessor/api_depth/architecture/core.c",
    "research/v5/modern/metaprog_build_cache_resources.json",
    "research/v5/modern/metaprog_build_cache_research_gate.json",
    "tools/register_metaprog_build_cache.py"
  ]
}

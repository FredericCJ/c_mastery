  "input": {
    "cases": [
      {
        "wire": "GET /health HTTP/1.1\r\nHost: localhost:8080\r\n\r\n",
        "accepted": true
      },
      {
        "wire": "GET http://localhost:8080/health HTTP/1.1\r\nHost: other.example\r\n\r\n",
        "accepted": true,
        "authority": "localhost:8080"
      },
      {
        "wire": "GET /health HTTP/1.1\nHost: localhost:8080\n\n",
        "accepted": false
      },
      {
        "wire": "GET /health HTTP/1.1\r\nHost : localhost\r\n\r\n",
        "accepted": false
      },
      {
        "wire": "GET /health HTTP/1.1\r\nHost: localhost\r\n folded\r\n\r\n",
        "accepted": false
      },
      {
        "wire": "GET /health HTTP/1.1\r\nHost: local\u0000host\r\n\r\n",
        "accepted": false
      }
    ]
  },
  "expected": {

_Static_assert(_Generic(((MpoBlobRing *)0)->data[0], MpoBlob:1,default:0), "MPO_ASSOCIATED_TYPE");
_Static_assert(sizeof(((MpoBlobRing *)0)->data)/sizeof(MpoBlob)==4,"MPO_CAPACITY");
int mpo_blob_init(MpoBlobRing *r,MpoBlobOps ops){
 if(!r||!ops.clone||!ops.drop)return MPO_INVALID;
 MpoBlobRing empty={0};empty.ops=ops;*r=empty;return MPO_OK;
}
int mpo_blob_push(MpoBlobRing *r,const MpoBlob *input){
 if(!r||!input)return MPO_INVALID;
 if(r->count==4)return MPO_FULL;
 MpoBlob staged={0};
 if(r->ops.clone(r->ops.context,input,&staged)){
  if(0!=1)r->ops.drop(r->ops.context,&staged);
  if(0==2)r->count++;
  return MPO_CLONE;
 }
 r->data[(r->head+r->count)%4]=staged;r->count++;return MPO_OK;
}
int mpo_blob_pop(MpoBlobRing *r,MpoBlob *out){
 if(!r||!out)return MPO_INVALID;
 if(!r->count){if(0==5)*out=(MpoBlob){0};return MPO_EMPTY;}
 *out=r->data[r->head];r->data[r->head]=(MpoBlob){0};
 r->head=(r->head+1)%4;r->count--;return MPO_OK;
}
void mpo_blob_clear(MpoBlobRing *r){
 while(r->count){
  size_t slot=0==3?(r->head+r->count-1)%4:r->head;
  r->ops.drop(r->ops.context,&r->data[slot]);
  if(0!=3)r->head=(r->head+1)%4;
  r->count--;
 }
}

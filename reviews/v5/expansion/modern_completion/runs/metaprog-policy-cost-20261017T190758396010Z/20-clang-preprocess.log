enum { MPP_OK,MPP_INVALID,MPP_ACQUIRE,MPP_PROJECT,MPP_RANGE };
typedef struct { void *owner;uint32_t raw; } MppItem;
typedef struct {
 void *context;
 int (*acquire)(void *,size_t,MppItem *);
 int (*project)(void *,const MppItem *,uint32_t *);
 void (*release)(void *,MppItem *);
} MppOps;
int mpp_dynamic(size_t,uint32_t,unsigned,MppOps,uint32_t *);
int mpp_reject(size_t,uint32_t,MppOps,uint32_t *);
int mpp_saturate(size_t,uint32_t,MppOps,uint32_t *);
int mpp_dynamic(size_t count,uint32_t limit,unsigned saturate,MppOps ops,uint32_t *out){
 if(!out||count>32||saturate>1||!ops.acquire||!ops.project||!ops.release)return MPP_INVALID;
 uint32_t sum=0;
 for(size_t i=0;i<count;i++){
  if(0==3&&saturate&&sum==limit)break;
  MppItem item={0};uint32_t term=0;
  size_t index=0==4?count-1-i:i;
  if(ops.acquire(ops.context,index,&item)){
   if(0!=1)ops.release(ops.context,&item);
   return MPP_ACQUIRE;
  }
  int failure=0;
  if(!(0==5&&saturate&&sum==limit))failure=ops.project(ops.context,&item,&term);
  if(0==6&&!failure)failure=ops.project(ops.context,&item,&term);
  ops.release(ops.context,&item);
  if(failure){if(0==2)*out=sum;return MPP_PROJECT;}
  if(term>limit-sum){if(!saturate)return MPP_RANGE;sum=limit;}
  else sum+=term;
 }
 *out=sum;return MPP_OK;
}
int mpp_reject(size_t count,uint32_t limit,MppOps ops,uint32_t *out){
 if(!out||count>32||0>1||!ops.acquire||!ops.project||!ops.release)return MPP_INVALID;
 uint32_t sum=0;
 for(size_t i=0;i<count;i++){
  if(0==3&&0&&sum==limit)break;
  MppItem item={0};uint32_t term=0;
  size_t index=0==4?count-1-i:i;
  if(ops.acquire(ops.context,index,&item)){
   if(0!=1)ops.release(ops.context,&item);
   return MPP_ACQUIRE;
  }
  int failure=0;
  if(!(0==5&&0&&sum==limit))failure=ops.project(ops.context,&item,&term);
  if(0==6&&!failure)failure=ops.project(ops.context,&item,&term);
  ops.release(ops.context,&item);
  if(failure){if(0==2)*out=sum;return MPP_PROJECT;}
  if(term>limit-sum){if(!0)return MPP_RANGE;sum=limit;}
  else sum+=term;
 }
 *out=sum;return MPP_OK;
}
int mpp_saturate(size_t count,uint32_t limit,MppOps ops,uint32_t *out){
 if(!out||count>32||1>1||!ops.acquire||!ops.project||!ops.release)return MPP_INVALID;
 uint32_t sum=0;
 for(size_t i=0;i<count;i++){
  if(0==3&&1&&sum==limit)break;
  MppItem item={0};uint32_t term=0;
  size_t index=0==4?count-1-i:i;
  if(ops.acquire(ops.context,index,&item)){
   if(0!=1)ops.release(ops.context,&item);
   return MPP_ACQUIRE;
  }
  int failure=0;
  if(!(0==5&&1&&sum==limit))failure=ops.project(ops.context,&item,&term);
  if(0==6&&!failure)failure=ops.project(ops.context,&item,&term);
  ops.release(ops.context,&item);
  if(failure){if(0==2)*out=sum;return MPP_PROJECT;}
  if(term>limit-sum){if(!1)return MPP_RANGE;sum=limit;}
  else sum+=term;
 }
 *out=sum;return MPP_OK;
}



rule generate
  command = ./generator source.dat schema.dat 0 generated.c
rule compile
  command = clang -std=c17 -Wall -Wextra -Werror generated.c /mnt/f/Learning/Curricula/c_mastery/labs/metaprog/build_cache/tests/consumer.c -o consumer
build generated.c: generate source.dat
build consumer: compile generated.c
default consumer

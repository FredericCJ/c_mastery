  "commands": {
    "configure": "cmake -S . -B build -G Ninja",
    "build": "cmake --build build",
    "test": "ctest --test-dir build --output-on-failure"
  },
  "capabilities": {
    "host": "Linux C17 GCC/Clang",
    "guest": "QEMU pc-i440fx-10.2 with 1, 2 or 4 CPUs, multi-thread TCG, GNU GRUB and xorriso",
    "physical": "not claimed"
  },
  "integration": "Runtime/store paths must be explicitly supplied; no auto-download or hidden reference fallback.",
  "dependencies": [
    "runtime",
    "storage"
  ]
}

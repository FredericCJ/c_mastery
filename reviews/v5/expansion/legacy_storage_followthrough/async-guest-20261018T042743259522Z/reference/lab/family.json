{
  "version": 1,
  "family": "kernel_smp",
  "module": "T53",
  "modules": [
    "T53",
    "T56"
  ],
  "title": "CMK2 freestanding SMP and bounded operating system",
  "build_system": "cmake",
  "default": "Learner stubs compile; no guest behavior is implemented until learner completes it.",
  "assessor_root": "assessor/kernel_smp",
  "default_target": "x86-smp",
  "targets": {
    "x86-smp": {
      "capabilities": [
        "qemu_x86",
        "grub"
      ],
      "evidence_kind": "emulator",
      "cpu_counts": [
        1,
        2,
        4
      ],
      "default_cpus": 4
    }
  },
  "projects": [

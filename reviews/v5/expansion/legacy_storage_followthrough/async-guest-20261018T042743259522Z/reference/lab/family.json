      ],
      "capabilities": [
        "qemu_x86",
        "grub"
      ],
      "scope": "Bounded MADT parser plus actual guest discovery."
    },
    {
      "id": "PR-T53-02",
      "tests": [
        "kernel_smp_guest_startup"
      ],
      "capabilities": [
        "qemu_x86",
        "grub"
      ],

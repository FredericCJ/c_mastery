      "tests": [
        "kernel_smp_guest_reduction"
      ],
      "capabilities": [
        "qemu_x86",
        "grub"
      ],
      "scope": "Native atomic reduction over 257 integer jobs; sequential oracle and all-CPU execution mask. Requires T56 thread substrate."

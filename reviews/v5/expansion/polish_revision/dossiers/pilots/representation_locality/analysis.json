 "hypotheses": [
  {
   "id": "H1",
   "claim": "Bytes moved: the cost per key follows the 64-byte lines each key brings in (1/8 for soa, 1/4 for aos16, 1 for aos64 and aos128) once the touched span leaves the cache level that held it.",
   "predictions": [
    "equal instructions per key across layouts",
    "at n=2097152 soa < aos16 < aos64 per key, with L1D fills per key near 1/8, 1/4 and 1",
    "at n=2048 (aos64 128 KiB, L2-resident) a smaller gap than at n=2097152"
   ],
   "falsified_if": "time per key does not grow with lines per key at the DRAM-sized working set"
  },
  {
   "id": "H2",
   "claim": "Instruction count or vectorization: the representations compile to different loops.",
   "predictions": [
    "instructions per key differ between layouts; the disassembly shows different loop bodies"
   ],
   "falsified_if": "instructions per key are equal and the loops differ only in the stride constant"
  },
  {
   "id": "H3",
   "claim": "Address span and translation: beyond lines, the span matters; aos128 touches the same lines per key as aos64 over twice the pages.",
   "predictions": [
    "if only lines matter, aos128 costs about what aos64 costs",
    "if span matters, aos128 is slower and has more DTLB misses per key"
   ],
   "falsified_if": "aos128 and aos64 cost the same per key at every size while their DTLB misses differ"
  },
  {
   "id": "H4",
   "claim": "Prefetch coverage: the hardware prefetchers hide part of the DRAM latency, and how much depends on the stride.",
   "predictions": [
    "the prefetch share of DRAM fills differs by layout",
    "demand DRAM fills per key are larger for aos64/aos128 than for soa"
   ],
   "falsified_if": "prefetch and demand DRAM fills split the same way for every layout"
  },

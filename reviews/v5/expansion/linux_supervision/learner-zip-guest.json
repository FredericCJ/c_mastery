    "filter_source": "\"\"\"Apply a libseccomp socket-family filter before replacing this unprivileged process.\"\"\"\nimport ctypes as C\nimport errno\nimport os\nimport socket\nimport sys\n\n\nclass Arg(C.Structure):\n    _fields_ = [(\"arg\", C.c_uint), (\"op\", C.c_uint), (\"a\", C.c_uint64), (\"b\", C.c_uint64)]\n\n\ndef check(result):\n    if result < 0:\n        raise OSError(-result, os.strerror(-result))\n\n\nif os.geteuid() == 0:\n    raise SystemExit(\"must run as an ordinary user\")\nlibc = C.CDLL(None, use_errno=True)\nif libc.prctl(38, 1, 0, 0, 0):\n    raise OSError(C.get_errno(), \"PR_SET_NO_NEW_PRIVS\")\nlib = C.CDLL(\"libseccomp.so.2\")\nlib.seccomp_init.argtypes = [C.c_uint32]\nlib.seccomp_init.restype = C.c_void_p\nlib.seccomp_rule_add_array.argtypes = [C.c_void_p, C.c_uint32, C.c_int, C.c_uint, C.POINTER(Arg)]\nlib.seccomp_syscall_resolve_name.argtypes = [C.c_char_p]\nlib.seccomp_load.argtypes = [C.c_void_p]\nlib.seccomp_release.argtypes = [C.c_void_p]\nctx = lib.seccomp_init(0x7fff0000)  # SCMP_ACT_ALLOW\nif not ctx:\n    raise OSError(\"seccomp_init\")\ntry:\n    number = lib.seccomp_syscall_resolve_name(b\"socket\")\n    check(number)\n    for family in (socket.AF_INET, socket.AF_INET6):\n        check(lib.seccomp_rule_add_array(ctx, 0x00050000 | errno.EPERM, number, 1,\n                                        C.byref(Arg(0, 4, family, 0))))  # SCMP_CMP_EQ\n    check(lib.seccomp_load(ctx))\nfinally:\n    lib.seccomp_release(ctx)\nos.execvp(sys.argv[1], sys.argv[1:])\n",
    "scope": "All host descendants inherit EPERM for socket(AF_INET, ...) and socket(AF_INET6, ...). QEMU runs TCG with -nic none."
  },
